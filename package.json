{
  "name": "tokenstat",
  "version": "0.1.0",
  "description": "Local coding-agent usage and cost reports, powered by Rust",
  "type": "module",
  "main": "native/binding.cjs",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "tokenstat": "dist/index.js"
  },
  "files": ["dist", "native/binding.cjs", "native/binding.d.cts"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "napi": {
    "binaryName": "tokenstat-core",
    "packageName": "@shanthropic/tokenstat",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shanthropic/tokenstat.git"
  },
  "scripts": {
    "prepare": "husky",
    "start": "tsx ./src/index.ts",
    "dev": "tsx --watch ./src/index.ts",
    "export": "tsx ./src/index.ts export",
    "export:watch": "tsx --watch ./src/index.ts export",
    "image": "tsx ./src/index.ts image",
    "image:watch": "tsx --watch ./src/index.ts image",
    "build:rust": "napi build --platform --release --manifest-path ./crates/core/Cargo.toml --output-dir native --js binding.cjs --dts binding.d.cts -- --locked",
    "build:rust:debug": "napi build --platform --manifest-path ./crates/core/Cargo.toml --output-dir native --js binding.cjs --dts binding.d.cts -- --locked",
    "build:js": "tsdown --config ./tsdown.config.ts",
    "build": "pnpm run build:rust && pnpm run build:js",
    "build:watch": "tsdown --config ./tsdown.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@inquirer/core": "^11.2.1",
    "@napi-rs/cli": "3.10.9",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.13.3",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-oxfmt": "^0.28.0",
    "fuse.js": "^7.5.0",
    "husky": "^9.1.7",
    "ms": "^2.1.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "rolldown": "1.0.0-rc.13",
    "terminal-image": "^5.0.1",
    "tsdown": "^0.15.12",
    "tslib": "^2.8.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "ulid": "^3.0.2",
    "vitest": "^4.1.10"
  }
}
